#!/bin/sh

export PACKAGE="libblockdev"
export PORTS="libblockdev libblockdev-btrfs libblockdev-crypto libblockdev-dm libblockdev-fs libblockdev-loop libblockdev-lvm libblockdev-mdraid libblockdev-mpath libblockdev-nvme libblockdev-part libblockdev-swap libblockdev-utils"
export DROP_FILES=""
