#!/bin/sh

export PACKAGE=systemd
export PORTS="systemd systemd-libs systemd-networkd systemd-pam systemd-resolved systemd-udev"
export DROP_FILES="	etc.conf \
			systemd-growfs \
			systemd-makefs \
			systemd-fsck \
			shutdown \
			ldconfig.service \
			installkernel"

export DROP_DIRS="	lib64/zsh \
			lib64/systemd/boot/efi \
			lib64/doc \
			lib64/factory \
			lib64/systemd/system-generators \
			etc/systemd/system/sysinit.target.wants"

repackage -e
returnval=$?

mkdir -p ./packages/$PACKAGE/sbin
for i in runlevel reboot poweroff halt telinit; do
	ln -sf ../bin/systemctl ./packages/$PACKAGE/sbin/$i
	let returnval=returnval+$?
done
for link in init sbin/init ; do
	ln -sf /lib64/systemd/systemd ./packages/$PACKAGE/$link
	let returnval=returnval+$?
done

ln -sf libudev.so.1 ./packages/$PACKAGE/lib64/libudev.so.0

exit $returnval
