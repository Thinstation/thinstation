# Define lighttpd rules
nft add set ip filter lighttpd_clients '{ type ipv4_addr; flags timeout; timeout 5m; }'
nft add rule ip filter INPUT ip saddr 192.168.0.0/16 tcp dport { 80, 443 } add @lighttpd_clients { ip saddr }
nft add rule ip filter OUTPUT ip daddr 192.168.0.0/16 tcp sport { 80, 443 } ip daddr @lighttpd_clients accept
