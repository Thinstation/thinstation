[Unit]
Description=Configure Network Connections Automatically
After=post-udev.service	network-pre.target dbus.service choose-network.service
Before=network-online.target network.target
Wants=network.target network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=/etc/thinstation.env
ExecStart=/etc/init.d/hostname
SyslogIdentifier=thinstation

[Install]
WantedBy=multi-user.target
