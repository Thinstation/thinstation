#!/bin/sh

export PACKAGE=alsa
export PORTS="alsa-utils"
export DROP_FILES="speaker-test alsa aconnect alsaloop alsaucm amidi aplaymidi arecord arecordmidi aseqdump aseqnet iecset alsaconf aserver alsamixer aserver"
