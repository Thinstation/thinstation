mkdir -p /ts/build/packages/switchuser/bin
mkdir -p /ts/build/packages/switchuser/sbin
ln /bin/login /ts/build/packages/switchuser/bin/.
ln /sbin/unix_chkpwd /ts/build/packages/switchuser/sbin/.
ln /usr/bin/su /ts/build/packages/switchuser/bin/.
ln /usr/sbin/grpconv /ts/build/packages/switchuser/sbin/.
ln /usr/sbin/pwconv /ts/build/packages/switchuser/sbin/.
