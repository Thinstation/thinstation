#5b128ef0979f57845894d1157072a8b1  .dna

mkdir -p /ts/build/packages/xorg7-intel/lib64
mkdir -p /ts/build/packages/xorg7-intel/lib64/dri
mkdir -p /ts/build/packages/xorg7-intel/lib64/gallium-pipe
mkdir -p /ts/build/packages/xorg7-intel/lib64/vulkan/icd.d
mkdir -p /ts/build/packages/xorg7-intel/lib64/xorg/modules/drivers
ln //usr/lib64/dri/libdril_dri.so /ts/build/packages/xorg7-intel/lib64/dri/libdril_dri.so
ln //usr/lib64/gallium-pipe/pipe_i915.so /ts/build/packages/xorg7-intel/lib64/gallium-pipe/pipe_i915.so
ln //usr/lib64/libvulkan_intel.so /ts/build/packages/xorg7-intel/lib64/libvulkan_intel.so
ln //usr/lib64/libvulkan_intel_hasvk.so /ts/build/packages/xorg7-intel/lib64/libvulkan_intel_hasvk.so
ln //usr/lib64/xorg/modules/drivers/intel_drv.so /ts/build/packages/xorg7-intel/lib64/xorg/modules/drivers/intel_drv.so
ln //usr/share/vulkan/icd.d/intel_hasvk_icd.x86_64.json /ts/build/packages/xorg7-intel/lib64/vulkan/icd.d/intel_hasvk_icd.x86_64.json
ln //usr/share/vulkan/icd.d/intel_icd.x86_64.json /ts/build/packages/xorg7-intel/lib64/vulkan/icd.d/intel_icd.x86_64.json
ln -sf libdril_dri.so /ts/build/packages/xorg7-intel/lib64/dri/i915_dri.so
